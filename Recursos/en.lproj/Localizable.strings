"Aprovado %@ · %d min %d s sem repousar" = "Passed %@ · %d min %d s without sleeping";
"Reprovado: %@" = "Failed: %@";
"Feche o Mac 1 minuto; o app confere se ele repousou" = "Close the Mac for 1 minute; the app checks whether it slept";
"Abrir no Início da Sessão" = "Open at Login";
"Aguardando aprovação nos Ajustes do Sistema" = "Waiting for approval in System Settings";
"Restaurar Padrões de Energia…" = "Restore Power Defaults…";
